{
  "name": "socniti",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "precheck": "node check-prerequisites.js",
    "dev": "concurrently \"npm run dev --workspace @socniti/frontend\" \"npm run dev --workspace @socniti/backend\"",
    "dev:frontend": "npm run dev --workspace @socniti/frontend",
    "lint": "npm run lint --workspaces --if-present",
    "dev:backend": "npm run dev --workspace @socniti/backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "mongodb-memory-server": "^11.1.0"
  }
}
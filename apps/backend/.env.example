# ── Server ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# ── Database ─────────────────────────────────────────────────────
# Supabase PostgreSQL connection string (use the pooler URL for production)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres

# ── Auth ─────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=30d

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CLIENT_URL=https://your-app.vercel.app,https://your-custom-domain.com

# ── Email (Gmail SMTP) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=SOCNITI <your-email@gmail.com>
